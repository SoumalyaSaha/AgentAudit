# Only needed if you run with AGENTAUDIT_LIVE_MODE=true (see scripts/capture_fixtures.py)
NEBIUS_API_KEY=
AGENTAUDIT_LIVE_MODE=false
# Only needed for --backend sandbox (real Nebius Sandboxes runs, see
# engine/sandbox_backend.py and scripts/smoke_sandbox.py). Sandboxes is a
# separate product permission on the same Token Factory account, so it uses
# the SAME NEBIUS_API_KEY as Token Factory plus a project id (there is no
# separate NEBIUS_SANDBOX_TOKEN).
NEBIUS_PROJECT_ID=
# Optional Sandboxes tuning (defaults shown). Documented here so every env
# var the code reads is listed in one place.
AGENTAUDIT_SANDBOX_IMAGE=python:3.11
AGENTAUDIT_SANDBOX_TIMEOUT=300
